# CodeCanvas 环境变量模板
# 复制为 backend/.env 并填入真实值；切勿把真实 .env 提交到版本库。

# 模型调用模式：mock（离线自测）/ http（真实调用）
CODECANVAS_LLM_MODE=auto

# 供应商标识：openai-compatible（兼容 OpenAI 协议的服务）
CODECANVAS_PROVIDER=openai

# API Base URL，例如 https://api.deepseek.com/v1
CODECANVAS_OPENAI_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

CODECANVAS_OPENAI_KEY=your-key-here

# 最强档模型，用于高难度任务
CODECANVAS_MODEL_FLAGSHIP=qwen3-coder-next

# 标准档模型，日常默认
CODECANVAS_MODEL_STANDARD=qwen3-coder-next

# 轻量档模型，用于简单抽取类任务
CODECANVAS_MODEL_LIGHT=qwen3-coder-flash
